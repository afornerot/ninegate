{% extends 'base.html.twig' %}

{% block body %}
<h1>{{ title }}</h1>
{% if isAdmin %}
<a href="{{ path('app_admin_charte_submit') }}" class="btn btn-primary mb-3">
    <i class="fas fa-plus"></i> Ajouter
</a>
{% endif %}

<div class="card">
    <div class="card-body p-3">
        <div class="table-responsive">
            <table class="table table-striped table-bordered mb-0" id="table">
                <thead>
                    <tr>
                        <th class="text-nowrap" data-orderable="false" width="100px">Actions</th>
                        <th>Titre</th>
                        <th>Créée le</th>
                        <th>Signature</th>
                        <th>Groupes</th>
                        <th>Rôles</th>
                        {% if not isAdmin %}
                            <th>Statut</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for charte in chartes %}
                    <tr>
                        <td class="text-nowrap">
                            {% if isAdmin %}
                                <a href="{{ path('app_admin_charte_view', {id: charte.id}) }}" class="btn btn-sm btn-secondary" title="Voir">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_admin_charte_update', {id: charte.id}) }}" class="btn btn-sm btn-secondary" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="{{ path('app_admin_charte_delete', {id: charte.id}) }}" class="btn btn-sm btn-danger" title="Supprimer" onclick="return confirm('Supprimer cette charte ?')">
                                    <i class="fas fa-trash"></i>
                                </a>
                            {% else %}
                                <a href="{{ path('app_user_charte_view', {id: charte.id}) }}" class="btn btn-sm btn-secondary" title="Voir">
                                    <i class="fas fa-eye"></i>
                                </a>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path(isAdmin ? 'app_admin_charte_view' : 'app_user_charte_view', {id: charte.id}) }}" class="text-decoration-none">
                                {{ charte.title }}
                            </a>
                        </td>
                        <td>{{ charte.createdAt|date('d/m/Y H:i') }}</td>
                        <td>
                            {% if charte.requireSignature %}
                                <span class="badge bg-warning text-dark"><i class="fas fa-signature"></i> Obligatoire</span>
                            {% else %}
                                <span class="badge bg-secondary">Non</span>
                            {% endif %}
                        </td>
                        <td>
                            {% for group in charte.groups %}
                                <span class="badge bg-primary">{{ group.name }}</span>
                            {% else %}
                                <span class="text-muted">-</span>
                            {% endfor %}
                        </td>
                        <td>
                            {% set roleLabels = {'ROLE_ADMIN': 'Admin', 'ROLE_MASTER': 'Master', 'ROLE_USER': 'User', 'ROLE_VISITOR': 'Visitor'} %}
                            {% for role in charte.roles %}
                                <span class="badge bg-secondary">{{ roleLabels[role] ?? role }}</span>
                            {% else %}
                                <span class="text-muted">-</span>
                            {% endfor %}
                        </td>
                        {% if not isAdmin %}
                            <td>
                                {% if charte.requireSignature %}
                                    {% if charte.hasUserSigned(app.user) %}
                                        <span class="badge bg-success"><i class="fas fa-check"></i> Signée</span>
                                    {% else %}
                                        <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-triangle"></i> À signer</span>
                                    {% endif %}
                                {% else %}
                                    <span class="badge bg-info">-</span>
                                {% endif %}
                            </td>
                        {% endif %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block localscript %}
<script>
$(document).ready(function() {
    $('#table').DataTable({
        order: [[1, 'asc']]
    });
});
</script>
{% endblock %}
