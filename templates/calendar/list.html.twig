{% extends 'base.html.twig' %}

{% block body %}
<h1>{{ title }}</h1>

<div class="card mb-3">
    <div class="card-body d-flex align-items-center gap-3">
        <div>
            <strong>Configuration CalDAV :</strong> URL de découverte :
        </div>
        <code class="flex-grow-1">{{ app.request.schemeAndHttpHost }}{{ path('app_caldav') }}/calendars/{{ app.user.username }}/</code>
        <button class="btn btn-sm btn-outline-secondary" onclick="navigator.clipboard.writeText('{{ app.request.schemeAndHttpHost }}{{ path('app_caldav') }}/calendars/{{ app.user.username }}/')">
            <i class="fas fa-copy"></i>
        </button>
    </div>
</div>

<div class="d-flex gap-2 mb-3">
    <a href="{{ path(isAdmin ? 'app_admin_calendar_submit' : 'app_user_calendar_submit') }}" class="btn btn-primary">
        <i class="fas fa-plus"></i> Nouveau Calendrier
    </a>
</div>

<div class="card">
    <div class="card-body p-3">
        <div class="table-responsive">
        <table class="table table-striped table-bordered mb-0" id="table">
            <thead>
                <tr>
                    <th class="text-nowrap" data-orderable="false" width="100px">Actions</th>
                    <th>Titre</th>
                    <th>Slug</th>
                    <th>Couleur</th>
                    <th>Événements</th>
                    <th>Groupes</th>
                    <th>URL CalDAV</th>
                </tr>
            </thead>
            <tbody>
                {% for calendar in calendars %}
                    {% if is_granted('calendar_view', calendar) %}
                    <tr>
                        <td class="text-nowrap">
                            <a href="{{ path(isAdmin ? 'app_admin_calendar_view' : 'app_user_calendar_view', {slug: calendar.slug}) }}" class="btn btn-sm btn-success" title="Voir">
                                <i class="fas fa-eye"></i>
                            </a>
                            {% if is_granted('calendar_edit', calendar) %}
                                <a href="{{ path(isAdmin ? 'app_admin_calendar_update' : 'app_user_calendar_update', {id: calendar.id}) }}" class="btn btn-sm btn-secondary" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                            {% endif %}
                        </td>
                        <td>{{ calendar.title }}</td>
                        <td>{{ calendar.slug }}</td>
                        <td>
                            {% if calendar.color %}
                                <span class="badge" style="background-color: {{ calendar.color }}; color: #fff;">&nbsp;</span>
                            {% endif %}
                        </td>
                        <td>{{ calendar.events|length }}</td>
                        <td>
                            {% for group in calendar.groups %}
                                <span class="badge bg-info">{{ group.name }}</span>
                            {% else %}
                                -
                            {% endfor %}
                        </td>
                        <td>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control form-control-sm font-monospace" value="{{ app.request.schemeAndHttpHost }}{{ path('app_caldav') }}/calendars/{{ app.user.username }}/{{ calendar.id }}/" readonly>
                                <button class="btn btn-outline-secondary btn-sm" onclick="navigator.clipboard.writeText('{{ app.request.schemeAndHttpHost }}{{ path('app_caldav') }}/calendars/{{ app.user.username }}/{{ calendar.id }}/')">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
        </div>
    </div>
</div>
{% endblock %}

{% block localscript %}
<script>
$(document).ready(function() {
    $('#table').DataTable({
        order: [[1, 'asc']]
    });
});
</script>
{% endblock %}
