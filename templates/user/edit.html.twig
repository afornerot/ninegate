{% extends 'base.html.twig' %}

{% block body %}
<h1>{{ title }}</h1>

{{ form_start(form) }}
<div class="d-flex gap-2 mb-3">
    {{ form_widget(form.submit) }}
    {% if routecancel is defined %}
        <a href="{{ path(routecancel) }}" class="btn btn-secondary">Annuler</a>
    {% endif %}
    {% if routedelete is defined and mode != 'submit' %}
        <a href="{{ path(routedelete, {id: user.id}) }}" class="btn btn-danger ms-auto" onclick="return confirm('Voulez-vous supprimer cet utilisateur ?')">Supprimer</a>
    {% endif %}
</div>

<div class="text-center d-flex flex-column align-items-center">
    {{ form_row(form.avatar) }}
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Informations</h5>
            </div>
            <div class="card-body">
                {{ form_row(form.username) }}
                {{ form_row(form.email) }}
                {{ form_row(form.firstname) }}
                {{ form_row(form.lastname) }}
                {{ form_row(form.pseudo) }}
                {% if mode != 'profil' %}
                    {{ form_row(form.roles) }}
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-md-6">
        {% if form.password is defined %}
        <div class="card">
            <div class="card-header">
                <h5>Mot de passe</h5>
            </div>
            <div class="card-body">
                {{ form_row(form.password.first) }}
                {{ form_row(form.password.second) }}
            </div>
        </div>
        {% endif %}

        <div class="card{% if form.password is defined %} mt-3{% endif %}">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5>Clé API (CalDAV)</h5>
                {% if user.apiKey %}
                    <a href="{{ path(mode == 'profil' ? 'app_user_regenerate_apikey' : 'app_admin_user_regenerate_apikey', {id: user.id}) }}" class="btn btn-sm btn-warning" onclick="return confirm('Régénérer la clé API ? L\'ancienne clé sera invalide.')">
                        <i class="fas fa-sync"></i> Régénérer
                    </a>
                {% endif %}
            </div>
            <div class="card-body">
                {% if user.apiKey %}
                    <div class="input-group">
                        <input type="text" class="form-control font-monospace" value="{{ user.apiKey }}" readonly id="apiKeyValue">
                        <button type="button" class="btn btn-outline-secondary" onclick="navigator.clipboard.writeText(document.getElementById('apiKeyValue').value)">
                            <i class="fas fa-copy"></i>
                        </button>
                    </div>
                    <small class="text-muted mt-1 d-block">Copiez cette clé pour configurer votre client CalDAV.</small>
                {% else %}
                    <p class="text-muted mb-2">Aucune clé API générée.</p>
                    <a href="{{ path(mode == 'profil' ? 'app_user_regenerate_apikey' : 'app_admin_user_regenerate_apikey', {id: user.id}) }}" class="btn btn-primary">
                        <i class="fas fa-key"></i> Générer une clé API
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{{ form_end(form) }}
{% endblock %}
