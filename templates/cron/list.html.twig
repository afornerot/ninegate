{% extends 'base.html.twig' %}

{% block body %}
<h1>{{ title }}</h1>

<div class="card">
    <div class="card-body p-3">
        <div class="table-responsive">
        <table class="table table-striped table-bordered mb-0" id="table">
            <thead>
                <tr>
                    <th class="text-nowrap" data-orderable="false" width="100px">Actions</th>
                    <th>Prochaine exécution</th>
                    <th>Commande</th>
                    <th>Description</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody>
                {% for cron in crons %}
                <tr>
                    <td class="text-nowrap">
                        {% if routeupdate is defined %}
                            <a href="{{ path(routeupdate, {id: cron.id}) }}" class="btn btn-sm btn-secondary" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                        {% endif %}
                        {% if routedelete is defined %}
                            <a href="{{ path(routedelete, {id: cron.id}) }}" class="btn btn-sm btn-danger" title="Supprimer" onclick="return confirm('Voulez-vous supprimer ce cron ?')">
                                <i class="fas fa-trash"></i>
                            </a>
                        {% endif %}
                    </td>
                    <td>{{ cron.nextexecdate|date("d/m/Y H:i") }}</td>
                    <td class="font-monospace text-nowrap">{{ cron.command }}</td>
                    <td>{{ cron.description }}</td>
                    <td>{{ cron.statutlabel }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    </div>
</div>
{% endblock %}

{% block localscript %}
<script>
$(document).ready(function() {
    $('#table').DataTable({
        order: [[1, 'asc']]
    });
});
</script>
{% endblock %}
