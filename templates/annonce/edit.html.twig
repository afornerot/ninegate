{% extends 'base.html.twig' %}

{% block body %}
<h1>{{ title }}</h1>

{{ form_start(form) }}
<div class="d-flex gap-2 mb-3">
    <button type="submit" class="btn btn-success">Valider</button>
    <a href="{{ path('app_admin_annoncecategory_list') }}" class="btn btn-secondary">Annuler</a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Annonce</h5>
            </div>
            <div class="card-body">
                {{ form_row(form.title) }}
                {{ form_row(form.content) }}
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Paramètres</h5>
            </div>
            <div class="card-body">
                {{ form_row(form.category) }}
                {{ form_row(form.sortOrder) }}
                {{ form_row(form.canBeHidden) }}
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Permissions</h5>
            </div>
            <div class="card-body">
                {{ form_row(form.allUsers) }}
                <div class="annonce-perms-fields">
                    {{ form_row(form.groups) }}
                    {{ form_row(form.roles) }}
                </div>
            </div>
        </div>
    </div>
</div>

{{ form_end(form) }}

<script>
document.addEventListener('DOMContentLoaded', function() {
    var checkbox = document.getElementById('annonce_type_allUsers');
    var perms = document.querySelector('.annonce-perms-fields');
    if (checkbox && perms) {
        perms.style.display = checkbox.checked ? 'none' : '';
        checkbox.addEventListener('change', function() {
            perms.style.display = this.checked ? 'none' : '';
        });
    }
});
</script>
{% endblock %}
