{% extends 'base.html.twig' %}

{% block body %}
<h1>{{ title }}</h1>

<div class="d-flex gap-2 mb-3">
    <a href="{{ path('app_admin_annoncecategory_submit') }}" class="btn btn-primary">
        <i class="fas fa-plus"></i> Catégorie
    </a>
</div>

<div id="category-sortable">
    {% for category in categories %}
        <div class="card mb-3 category-card" data-category-id="{{ category.id }}">
            <div class="card-header d-flex align-items-center justify-content-between p-2" style="{% if category.bgColor %}background-color: {{ category.bgColor }};{% endif %}{% if category.textColor %} color: {{ category.textColor }};{% endif %}">
                <div class="d-flex align-items-center gap-2">
                    <i class="fas fa-grip-vertical" style="cursor: grab;{% if category.textColor %} color: {{ category.textColor }};{% endif %}"></i>
                    {% if category.icon %}
                        <img src="{{ bninefile(category.icon.route) }}" alt="" style="height: 24px; width: 24px; object-fit: contain;">
                    {% endif %}
                    <strong>{{ category.title }}</strong>
                    <span class="badge" style="background-color: {{ category.color ?: 'var(--bs-secondary)' }};{% if category.textColor %} color: {{ category.textColor }};{% endif %}">{{ category.annonces|length }}</span>
                </div>
                <div class="d-flex gap-1">
                    <a href="{{ path('app_admin_annonce_submit', {categoryId: category.id}) }}" class="btn btn-sm {{ category.textColor ? 'btn-outline-success' : 'btn-success' }}" title="Ajouter une annonce">
                        <i class="fas fa-plus"></i>
                    </a>
                    <a href="{{ path('app_admin_annoncecategory_update', {id: category.id}) }}" class="btn btn-sm {{ category.textColor ? 'btn-outline-light' : 'btn-secondary' }}" title="Modifier la catégorie">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a href="{{ path('app_admin_annoncecategory_delete', {id: category.id}) }}" class="btn btn-sm {{ category.textColor ? 'btn-outline-danger' : 'btn-danger' }}" title="Supprimer la catégorie" onclick="return confirm('Supprimer cette catégorie et toutes ses annonces ?')">
                        <i class="fas fa-trash"></i>
                    </a>
                </div>
            </div>
            <div class="card-body p-2 annonce-drop-zone" data-category-id="{{ category.id }}" style="{% if category.bgColor %}background-color: {{ category.bgColor }};{% endif %}{% if category.textColor %} color: {{ category.textColor }};{% endif %}">
                {% for annonce in category.annonces %}
                    <div class="card mb-1 annonce-card" data-annonce-id="{{ annonce.id }}" data-category-id="{{ category.id }}">
                        <div class="card-body p-2 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2 flex-grow-1">
                                <i class="fas fa-grip-vertical text-muted annonce-handle" style="cursor: grab;"></i>
                                <div>
                                    <strong>{{ annonce.title }}</strong>
                                    <span class="text-muted ms-1">&middot; {{ annonce.createdAt|date('d/m/Y H:i') }}</span>
                                    {% if annonce.canBeHidden %}
                                        <span class="badge bg-info ms-1">Masquable</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="d-flex gap-1">
                                {% if annonce.canBeHidden %}
                                    <a href="{{ path('app_admin_annonce_reset_hidden', {id: annonce.id}) }}" class="btn btn-sm btn-outline-warning" title="Rendre visible à tous" onclick="return confirm('Rendre cette annonce visible à tous les utilisateurs ?')">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                {% endif %}
                                <a href="{{ path('app_admin_annonce_update', {categoryId: category.id, id: annonce.id}) }}" class="btn btn-sm btn-secondary" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="{{ path('app_admin_annonce_delete', {categoryId: category.id, id: annonce.id}) }}" class="btn btn-sm btn-danger" title="Supprimer" onclick="return confirm('Supprimer cette annonce ?')">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
                {% if category.annonces|length == 0 %}
                    <p class="text-muted small mb-0 p-1 empty-msg">Aucune annonce. <a href="{{ path('app_admin_annonce_submit', {categoryId: category.id}) }}">Ajouter</a></p>
                {% endif %}
            </div>
        </div>
    {% else %}
        <p class="text-muted">Aucune catégorie. Créez-en une pour commencer.</p>
    {% endfor %}
</div>
{% endblock %}

{% block localscript %}
<script>
$(function() {
    var reorderCategoryUrl = '{{ path("app_admin_annoncecategory_reorder") }}';
    var moveAnnonceUrl = '{{ path("app_admin_annonce_move", {id: 0}) }}'.replace(/\/0$/, '');

    $('#category-sortable').sortable({
        handle: '.card-header .fa-grip-vertical',
        items: '> .category-card',
        cancel: '.annonce-drop-zone, .annonce-drop-zone *',
        placeholder: 'ui-state-highlight',
        update: function() {
            var order = [];
            $('#category-sortable .category-card').each(function() {
                order.push($(this).data('category-id'));
            });
            $.ajax({
                url: reorderCategoryUrl,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ order: order }),
                success: function() { showToast('Ordre sauvegardé', 'success'); },
                error: function() { showToast('Erreur', 'danger'); }
            });
        }
    });

    $('.annonce-card').draggable({
        handle: '.annonce-handle',
        helper: 'clone',
        revert: 'invalid',
        zIndex: 1000,
        cursor: 'grabbing',
        start: function() { $(this).css('opacity', '0.4'); },
        stop: function() { $(this).css('opacity', '1'); }
    });

    $('.annonce-drop-zone').droppable({
        accept: '.annonce-card',
        tolerance: 'pointer',
        over: function() { $(this).css('background', 'rgba(var(--bs-primary-rgb), 0.08)'); },
        out: function() { $(this).css('background', ''); },
        drop: function(event, ui) {
            $(this).css('background', '');
            var $annonce = ui.draggable;
            var annonceId = $annonce.data('annonce-id');
            var newCategoryId = $(this).data('category-id');

            var order = 0;
            var $annonces = $(this).find('.annonce-card');
            var dropY = ui.offset.top + ui.helper.height() / 2;
            $annonces.each(function(i) {
                var rect = this.getBoundingClientRect();
                if (dropY > rect.top + rect.height / 2) {
                    order = i + 1;
                }
            });

            var $clone = $annonce.clone().css({opacity: '1', position: '', top: '', left: ''});
            if (order >= $annonces.length) {
                $(this).append($clone);
            } else {
                $annonces.eq(order).before($clone);
            }
            $annonce.remove();

            $clone.draggable({
                handle: '.annonce-handle',
                helper: 'clone',
                revert: 'invalid',
                zIndex: 1000,
                cursor: 'grabbing',
                start: function() { $(this).css('opacity', '0.4'); },
                stop: function() { $(this).css('opacity', '1'); }
            });
            $clone.data('category-id', newCategoryId);

            $(this).find('.empty-msg').remove();

            $.ajax({
                url: moveAnnonceUrl + '/' + annonceId,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ categoryId: newCategoryId, order: order }),
                success: function() { showToast('Annonce déplacée', 'success'); },
                error: function() { showToast('Erreur', 'danger'); }
            });
        }
    });

    function showToast(message, type) {
        var $container = $('.toast-container');
        if (!$container.length) {
            $container = $('<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;"></div>').appendTo('body');
        }
        var $toast = $('<div class="toast align-items-center text-bg-' + type + ' border-0 show" role="alert"></div>');
        $toast.html('<div class="d-flex"><div class="toast-body">' + message + '</div>' +
            '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>');
        $container.append($toast);
        setTimeout(function() { $toast.remove(); }, 3000);
    }
});
</script>
{% endblock %}
