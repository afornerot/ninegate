APP_ENV=dev
APP_SECRET=changeme
APP_ENCRYPT_KEY="ow9z8G2PZyJpD8N+T1Nz9G7yP3W5v9a/72xFZdVxDME=" # IMPORTANT Générer votre propre clé via echo base64_encode(random_bytes(32))
DATABASE_URL="postgresql://user:changeme@postgres:5432/ninegate?serverVersion=17"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
DEFAULT_URI=https://localhost:8019
LOCK_DSN=flock
MAILER_DSN=smtp://mailhog:1025
MAILHOG_URL=http://localhost:8025

# Storage: local (défaut) ou s3 (RustFS / S3-compatible)
STORAGE_DSN="local://uploads"
STORAGE_S3=0
S3_ENDPOINT="http://rustfs:9000"
S3_BUCKET="ninegate-uploads"
S3_ACCESS_KEY="rustfs"
S3_SECRET_KEY="changeme"
S3_REGION="us-east-1"

APP_NAME="Ninegate"
APP_NOREPLY=admin@noreply.fr
APP_ADMIN="admin"
APP_ADMIN_PASSWORD=changeme

APP_MODEAUTH=SQL
# Source maîtresse des données d'identité utilisateur :
#   SQL  : ninegate gère login/nom/prénom/email/mot de passe (défaut)
#   LDAP : un annuaire LDAP externe gère ces données (synchronisation à venir)
#   SSO  : un fournisseur SSO (CAS/OIDC) gère ces données
# Si != SQL, APP_MODEAUTH doit être CAS ou OIDC.
APP_MASTERIDENTITY=SQL

CAS_HOST=auth.cadoles.com
CAS_PORT=443
CAS_PATH=/cas
CAS_USERNAME=uid
CAS_MAIL=mail
CAS_LASTNAME=lastname
CAS_FIRSTNAME=firstname

# ============================================================
# OpenLDAP (annuaire local fourni par le service openldap)
# ============================================================
# Connexion
LDAP_HOST=openldap
LDAP_PORT=389
LDAP_TLS=false

# Structure de l'annuaire
LDAP_BASEDN=dc=ninegate,dc=local
LDAP_USERSDN=ou=users,${LDAP_BASEDN}
LDAP_GROUPSDN=ou=groups,${LDAP_BASEDN}

# Attributs LDAP pour les utilisateurs
LDAP_ATTR_USERNAME=uid
LDAP_ATTR_LASTNAME=sn
LDAP_ATTR_FIRSTNAME=givenname
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_PASSWORD=userpassword

# Attributs LDAP pour les groupes
LDAP_ATTR_GROUP_CN=cn
LDAP_ATTR_GROUP_MEMBER=memberuid
LDAP_ATTR_GROUP_GID=gidnumber

# Compte writer (rootDN) — aligné sur APP_ADMIN / APP_ADMIN_PASSWORD
LDAP_WRITER_DN=cn=${APP_ADMIN},${LDAP_BASEDN}
LDAP_WRITER_PASSWORD=${APP_ADMIN_PASSWORD}

# Sens de la synchronisation d'identité
# false        : aucune synchronisation (défaut)
# NINE2GLAUTH  : ninegate → GLAuth (legacy, vue Postgres via plugin LDAP)
# NINE2LDAP    : ninegate → OpenLDAP (annuaire standard)
# LDAP2NINE    : OpenLDAP → ninegate
# Recommandé : aligner sur APP_MASTERIDENTITY
SYNC_IDENTITY=false

OIDC_ISSUER=
OIDC_CLIENTID=
OIDC_CLIENTSECRET=
OIDC_REDIRECTURI=
OIDC_MAILATTRIBUTE=email
OIDC_USERNAMEATTRIBUTE=preferred_username
# OIDC: nom des attributs pour prénom/nom. Laisser vide si votre IdP ne les fournit pas.
# Exemples : given_name / family_name (Keycloak standard), full_name (Gitea), name (LemonLDAP)
OIDC_FIRSTNAMEATTRIBUTE=
OIDC_LASTNAMEATTRIBUTE=